  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug server.mjs",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
